+    m_pCartridge->UpdateCurrentRTC();
+    s32 now = static_cast<s32>(m_pCartridge->GetCurrentRTC());
+    // The frontend restores this buffer directly. A timestamp different
+    // from our cache identifies a restored battery snapshot, not game time
+    // already advanced by TickRTC(). Catch up only that offline interval.
+    if (m_RTC.LastTime != m_RTCLastTimeCache)
+    {
+        m_RTCLastTimeCache = 0;
+        UpdateRTC();
+    }
+    // Timestamp the snapshot at export, so the next session does not add
+    // the previous session's emulated time a second time.
+    m_RTC.LastTime = now;
+    m_RTCLastTimeCache = now;
+    return reinterpret_cast<u8*>(&m_RTC);
 }
 
