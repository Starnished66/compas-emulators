# Malta guest kernel options for the R1-class VM.
# Start from upstream 4.4.94 malta_defconfig; keep emulated platform devices only.
CONFIG_32BIT=y
CONFIG_CPU_LITTLE_ENDIAN=y
CONFIG_CPU_MIPS32_R2=y
CONFIG_PAGE_SIZE_4KB=y
# Malta's reference defconfig enables MT-SMP, which implicitly forces SMP.
# The guest is intentionally a single CPU, so disable that selection first.
# CONFIG_MIPS_MT_SMP is not set
# CONFIG_SMP is not set
CONFIG_BINFMT_ELF=y
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SWAP=y
# Match the R1 kernel's preemptible scheduler, 100 Hz tick, and slab allocator.
CONFIG_PREEMPT=y
CONFIG_HZ_100=y
CONFIG_SLAB=y
# CONFIG_COMPACTION is not set
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_LZ4_COMPRESS=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_CIRRUS=y
CONFIG_FB_CONSOLE=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_AC97_CODEC=y
CONFIG_SND_INTEL8X0=y
CONFIG_SND_PCM_OSS=y
CONFIG_SND_MIXER_OSS=y
